{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "bg", "name": "Background", "color": "#0b1326" },
				{ "slug": "surface", "name": "Surface", "color": "#171f33" },
				{ "slug": "text", "name": "Text", "color": "#dbe2fd" },
				{ "slug": "muted", "name": "Muted", "color": "#bdc8d1" },
				{ "slug": "line", "name": "Line", "color": "#3e484f" },
				{ "slug": "accent", "name": "Accent", "color": "#8ed5ff" },
				{ "slug": "accent-soft", "name": "Accent Soft", "color": "rgba(142, 213, 255, 0.12)" },
				{ "slug": "result", "name": "Result", "color": "#4edea3" },
				{ "slug": "lane-consulting", "name": "Lane: Consulting", "color": "#bccbff" },
				{ "slug": "lane-building", "name": "Lane: Building", "color": "#8ed5ff" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1080px"
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "sora",
					"name": "Sora",
					"fontFamily": "Sora, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Sora",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/sora-latin-700-normal.woff2" ]
						}
					]
				},
				{
					"slug": "hanken-grotesk",
					"name": "Hanken Grotesk",
					"fontFamily": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/hanken-grotesk-latin-400-normal.woff2" ]
						}
					]
				},
				{
					"slug": "jetbrains-mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jetbrains-mono-latin-400-normal.woff2" ]
						}
					]
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--hanken-grotesk)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sora)"
				}
			},
			"code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--jetbrains-mono)"
				}
			}
		}
	}
}
